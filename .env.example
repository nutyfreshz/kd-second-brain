# Runtime
KNOWLEDGE_SOURCE=local
LOCAL_KNOWLEDGE_DIR=knowledge/published
ALLOW_ANONYMOUS_LOCAL=true
ADMIN_USERS=
MAX_CONCURRENT_INFERENCE=2
ENABLE_SEMANTIC=true
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Gemini direct API, primary
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FREE_VERIFIED=false

# OpenRouter, availability fallback only
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.5-9b
OPENROUTER_FREE_VERIFIED=false
OPENROUTER_PAID_ALLOWED=false

# Google Drive read-only source
GOOGLE_DRIVE_PUBLISHED_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=